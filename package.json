{
  "name": "seki",
  "productName": "Seki",
  "version": "0.2.0-alpha.6",
  "description": "An elegant Go/Baduk/Weiqi board and SGF editor with OGS integration and AI-powered analysis.",
  "author": "Duarte Adrien <contact@samda.net>",
  "homepage": "https://github.com/Samtroulcode/Seki-Sabaki",
  "license": "MIT",
  "main": "./src/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samtroulcode/Seki-Sabaki.git"
  },
  "bugs": {
    "url": "https://github.com/Samtroulcode/Seki-Sabaki/issues"
  },
  "build": {
    "appId": "net.samda.seki",
    "productName": "Seki",
    "copyright": "Copyright © 2026 Duarte Adrien",
    "compression": "normal",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "toolsets": {
      "appimage": "1.0.2"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "seki",
      "artifactName": "seki-v${version}-linux-${arch}.${ext}"
    },
    "flatpak": {
      "runtimeVersion": "23.08",
      "baseVersion": "23.08",
      "finishArgs": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Flatpak"
      ],
      "artifactName": "seki-v${version}-linux-${arch}-beta.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "notarize": true,
      "category": "public.app-category.board-games",
      "artifactName": "seki-v${version}-mac-${arch}.${ext}"
    },
    "win": {
      "artifactName": "seki-v${version}-windows.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Seki"
    },
    "fileAssociations": [
      {
        "ext": "sgf",
        "name": "Seki SGF",
        "description": "Smart Game Format"
      },
      {
        "ext": "ngf",
        "name": "Seki NGF",
        "description": "wBaduk NGF"
      },
      {
        "ext": "gib",
        "name": "Seki GIB",
        "description": "Tygem GIB"
      },
      {
        "ext": "ugf",
        "name": "Seki UGF",
        "description": "PandaNET UGF"
      }
    ],
    "files": [
      "**/*",
      "!**/{.github,.c9,scss,docs,test,tests,devtools,plugins,examples}${/*}",
      "!ci${/*}",
      "!src/{components,modules}${/*}",
      "src/modules/sgfanalysis*.js",
      "!engines",
      "!resources${/*}",
      "!node_modules",
      "node_modules/@primer/octicons/build/svg/*",
      "node_modules/@sabaki/deadstones/wasm/*",
      "node_modules/@sabaki/shudan/css/*",
      "node_modules/@sabaki/sgf/**/*",
      "node_modules/@sabaki/i18n/**/*",
      "node_modules/doken/**/*",
      "node_modules/dolm/**/*",
      "node_modules/jschardet/**/*",
      "node_modules/{iconv-lite,safer-buffer}/**/*",
      "node_modules/pikaday/css/*"
    ],
    "extraResources": [
      {
        "from": "build/analyze-sgf",
        "to": "analyze-sgf"
      },
      {
        "from": "resources/library",
        "to": "library"
      }
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "bracketSpacing": false,
    "proseWrap": "always",
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "dependencies": {
    "@mariotacke/color-thief": "^3.0.1",
    "@primer/octicons": "^19.29.2",
    "@sabaki/boardmatcher": "^1.2.0",
    "@sabaki/deadstones": "^2.2.0",
    "@sabaki/go-board": "^1.4.1",
    "@sabaki/gtp": "^3.1.1",
    "@sabaki/i18n": "0.51.1-1",
    "@sabaki/immutable-gametree": "^1.9.4",
    "@sabaki/influence": "^1.2.2",
    "@sabaki/sgf": "^3.5.0",
    "@sabaki/shudan": "^1.8.0",
    "argv-split": "^3.2.1",
    "classnames": "^2.2.6",
    "dolm": "^0.7.3-beta",
    "fix-path": "<6.0.0",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.0.0",
    "natsort": "^2.0.2",
    "pikaday": "^1.8.0",
    "preact": "^10.29.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "rimraf": "^6.1.2",
    "uuid": "^14.0.1",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "analyze-sgf": "git+https://github.com/Samtroulcode/analyze-sgf.git#8c05132107bb1a1b27d915ab79d5fdaeb3da9125",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.8.1",
    "mocha": "^11.7.6",
    "onchange": "^7.1.0",
    "pkg": "5.8.1",
    "prettier": "3.9.5",
    "tmp": "^0.2.7",
    "tsx": "^4.23.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "scripts": {
    "test": "mocha --require tsx",
    "start": "npm run bundle && node ./scripts/start.js",
    "bundle": "webpack --mode production",
    "prepare:analyze-sgf": "node ./scripts/prepare-analyze-sgf-binaries.js",
    "diagnose:analyze-sgf": "node ./scripts/diagnose-analyze-sgf.js",
    "build": "npm run bundle && npm run prepare:analyze-sgf && electron-builder --dir",
    "format-base": "prettier \"**/*.{js,html,md}\" \"!{{dist,i18n}/**,bundle.js*}\"",
    "format-check": "npm run format-base -- --check",
    "format": "npm run format-base -- --write",
    "watch-format": "onchange \"**/*.{js,html,md}\" \"!{{dist,i18n}/**,bundle.js*}\" -- prettier --write {{changed}}",
    "watch": "concurrently \"webpack --mode development --watch\" \"npm run watch-format\"",
    "dist:linux": "npm run bundle && npm run prepare:analyze-sgf linux-x64 && electron-builder -l AppImage --x64 --publish never",
    "dist:linux:arm64": "npm run bundle && npm run prepare:analyze-sgf linux-arm64 && electron-builder -l AppImage --arm64 --publish never",
    "dist:linux:all": "npm run bundle && npm run prepare:analyze-sgf linux-x64 linux-arm64 && electron-builder -l AppImage --x64 --arm64 --publish never",
    "dist:flatpak": "npm run bundle && npm run prepare:analyze-sgf && electron-builder -l flatpak --publish never",
    "dist:macos": "npm run bundle && npm run prepare:analyze-sgf darwin-x64 darwin-arm64 && electron-builder -m --x64 --arm64 --publish never",
    "dist:macos:unsigned": "npm run bundle && npm run prepare:analyze-sgf darwin-x64 darwin-arm64 && electron-builder -m --x64 --arm64 --publish never -c.mac.identity=null -c.mac.notarize=false -c.mac.hardenedRuntime=false",
    "dist:win64": "npm run bundle && npm run prepare:analyze-sgf win32-x64 && electron-builder -w nsis --x64 --publish never && node ./ci/mv.js ./dist/seki-vx.x.x-windows.exe ./dist/seki-vx.x.x-windows-x64-setup.exe",
    "dist:win64-portable": "npm run bundle && npm run prepare:analyze-sgf win32-x64 && electron-builder -w portable --x64 --publish never && node ./ci/mv.js ./dist/seki-vx.x.x-windows.exe ./dist/seki-vx.x.x-windows-x64-portable.exe",
    "dist:win": "npm run dist:win64 && npm run dist:win64-portable",
    "i18n": "node ./ci/createI18n.js",
    "gen:engine-transcripts": "node ./scripts/engine-transcripts/capture.mjs",
    "test:e2e": "webpack --mode development && (command -v xvfb-run >/dev/null 2>&1 && xvfb-run npx playwright test || npx playwright test)",
    "test:e2e:smoke": "webpack --mode development && (command -v xvfb-run >/dev/null 2>&1 && xvfb-run npx playwright test --project=smoke || npx playwright test --project=smoke)",
    "test:e2e:headed": "webpack --mode development && npx playwright test"
  }
}
